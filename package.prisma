#prisma 4.0
def package "luce-tls" {
    str owner = "dymokomi"
    str version = "0.1.4"
    str kind = "package"
    str language = "luce-base"
    str description = "Native Luce Base TLS 1.3 client: TlsStream (io.Reader/io.Writer) with deadlines and STARTTLS, certificate validation, and a small private-endpoint server. Experimental. MIT OR Apache-2.0."
    str readme = "README.md"

    def export "tls" {
        str module = "luce_tls.tls"
    }

    def export "x509" {
        str module = "luce_tls.x509"
    }

    def export "chain" {
        str module = "luce_tls.chain"
    }

    def export "session" {
        str module = "luce_tls.session"
    }

    def export "tls_stream" {
        str module = "luce_tls.stream"
    }

    def dependency "luce-crypto" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-crypto"
    }

    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-std"
    }
}
