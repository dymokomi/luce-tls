#prisma 4.0
def package "luce-tls" {
    str owner = "dymokomi"
    str version = "0.7.1"
    str kind = "package"
    str language = "luce-base"
    str description = "Native Luce Base TLS 1.3 client: tls_stream.Stream (io.Reader/io.Writer) with deadlines and STARTTLS, certificate validation, and a small private-endpoint server. Experimental. MIT OR Apache-2.0."
    str readme = "README.md"
    str[] public = ["chain", "session", "tls", "stream", "x509"]

    def dependency "luce-crypto" {
        str owner = "dymokomi"
        str path = "../luce-crypto"
    }

    def dependency "luce-std" {
        str owner = "dymokomi"
        str path = "../luce-std"
    }
}
