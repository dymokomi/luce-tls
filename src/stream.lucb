## Stream: one owned TCP connection that is either plain or TLS and implements
## io.Reader and io.Writer, so protocol code (IMAP, SMTP) needs no transport
## glue. It upgrades in place for STARTTLS. The socket is kept nonblocking and
## every transfer waits through readiness like `net.DeadlineStream`, under the
## stream's deadline and cancellation signal, so another thread can cancel a
## blocked read (an IMAP IDLE) and a timed-out TLS read resumes intact.
import io
from luce_std import net
import c
import sync
import platform
import record
import client
import trust

pub let invalid = record.invalid

## Re-exported trust policy; see `trust.Trust`.
pub type Trust = trust.Trust

## One plain or TLS client connection. Zero is closed. Copying does not
## duplicate ownership; close exactly one copy and synchronize calls on it.
pub struct Stream: io.Reader, io.Writer:
    var connection: net.Connection
    var channel: record.Channel
    var secure: bool
    var prepared: bool
    var deadline: net.Deadline
    var cancellation: sync.Cancellation*?

    ## Resolve `host`, try each address in resolver order, and, when `tls` is
    ## set, handshake under `policy` (default: the public roots). `alpn`, when
    ## not empty, is the one application protocol offered. `deadline` and
    ## `cancellation` bound the whole connect and stay set for later transfers.
    pub static func connect(host: str, port: u16, tls: bool, deadline: net.Deadline = net.Deadline(),
        cancellation: sync.Cancellation*? = none, policy: Trust = Trust(), alpn: str = "") -> Stream!:
        var host_c: u8[256]
        if host.length == 0 or host.length + 1 > host_c.length:
            error(invalid, "host name must be 1 to 255 bytes")
        for i in 0..<host.length:
            host_c[i] = host.bytes[i]
        host_c[host.length] = 0
        var addresses = try net.resolve_all((c.str)(str)host_c[..<host.length], port)
        defer addresses.destroy()
        let candidates = addresses.view()
        var stream = Stream(deadline = deadline, cancellation = cancellation)
        for i in 0..<candidates.length:
            let last = i + 1 == candidates.length
            let connection = net.Connection.connect(candidates[i], deadline, cancellation, nonblocking = true) catch failure:
                if last or failure.code == net.timed_out or failure.code == net.cancelled:
                    error(failure.code, failure.message)
                continue
            stream.connection = connection
            stream.prepared = true
            break
        errdefer stream.destroy()
        if tls:
            try stream.start_tls(host, policy, alpn)
        return stream

    ## Adopt a connected socket as a plain stream. It is made nonblocking on
    ## first use. The stream owns and closes it.
    pub static func plain(connection: net.Connection) -> Stream:
        return Stream(connection = connection)

    ## STARTTLS: run the TLS client handshake on this plain connection under
    ## the stream's deadline. Discard any plaintext buffered after the server's
    ## STARTTLS reply first (RFC 3207 §4.2, RFC 2595 §3.1). After a failure the
    ## stream is unusable and should be closed.
    pub mutating func start_tls(host: str, policy: Trust = Trust(), alpn: str = "") -> !:
        if self.secure:
            error(invalid, "the stream already uses TLS")
        var link = try self.link()
        try client.connect(&self.channel, &link, &link, host, &policy, alpn)
        self.secure = true

    ## The negotiated TLS cipher suite (0x1301 AES-128-GCM, 0x1302 AES-256-GCM,
    ## 0x1303 ChaCha20-Poly1305), or zero when plain.
    pub func cipher_suite() -> u16:
        return self.channel.cipher_suite()

    ## Whether a TLS session protects the stream.
    pub func is_secure() -> bool:
        return self.secure

    ## Apply an absolute `deadline` and optional `cancellation` to subsequent
    ## reads, writes and close. `net.Deadline()` removes the time limit.
    pub mutating func set_deadline(deadline: net.Deadline, cancellation: sync.Cancellation*? = none):
        self.deadline = deadline
        self.cancellation = cancellation

    ## Decrypted bytes already buffered: `read` returns them without touching
    ## the socket, and a socket readiness poll cannot see them. Zero when plain.
    pub func pending() -> usize:
        return self.channel.pending()

    ## Whether the TLS peer has sent close_notify; `read` then returns zero.
    pub func closed_by_peer() -> bool:
        return self.channel.closed_by_peer()

    ## Read some bytes under the stream's deadline. Zero on a nonempty buffer
    ## is the end of the stream (TCP EOF, or close_notify when secure). A
    ## timeout (`net.timed_out`) or cancellation (`net.cancelled`) leaves the
    ## stream usable.
    pub mutating func read(buffer: u8[]) -> usize!:
        return try self.read_within(buffer, self.deadline, self.cancellation)

    ## `read` with an explicit absolute deadline and cancellation for this call.
    pub mutating func read_within(buffer: u8[], deadline: net.Deadline, cancellation: sync.Cancellation*? = none) -> usize!:
        if buffer.length == 0:
            return 0
        var link = try self.link_with(deadline, cancellation)
        if self.secure:
            return try self.channel.read_application(&link, buffer)
        return try link.read(buffer)

    ## Send all of `data` under the stream's deadline and return its length.
    ## When secure, a failure part way leaves the TLS session unusable.
    pub mutating func write(data: const u8[]) -> usize!:
        try self.write_within(data, self.deadline, self.cancellation)
        return data.length

    ## Send all of `data` with an explicit absolute deadline and cancellation.
    pub mutating func write_within(data: const u8[], deadline: net.Deadline, cancellation: sync.Cancellation*? = none) -> !:
        if data.length == 0:
            return
        var link = try self.link_with(deadline, cancellation)
        if self.secure:
            try self.channel.write_application(&link, data)
        else:
            try io.write_all(&link, data)

    ## Wait for readiness. Read interest is satisfied at once by pending
    ## plaintext; otherwise this waits on the socket. Readiness is advisory: a
    ## readable TLS socket may hold only part of a record, or a record carrying
    ## no application data, so pair `read` with a deadline when a stall matters.
    pub func wait(interest: net.WaitInterest = net.WaitInterest.read, deadline: net.Deadline = net.Deadline(),
        cancellation: sync.Cancellation*? = none) -> net.Readiness!:
        if interest != net.WaitInterest.write and self.pending() > 0:
            return net.Readiness(readable = true, writable = interest == net.WaitInterest.both)
        return try self.connection.wait(interest, deadline, cancellation)

    ## Borrow the socket descriptor, for a `net.Poller`. Check `pending()`
    ## before polling, and never read or write the descriptor directly.
    pub func descriptor() -> platform.SocketDescriptor?:
        return self.connection.descriptor()

    ## The connected peer's address.
    pub func peer_address() -> net.SocketAddress!:
        return try self.connection.peer_address()

    ## Send close_notify when secure (best effort, under the stream's
    ## deadline), close the socket and erase the session keys. Safe to repeat.
    pub mutating func close() -> !:
        if self.connection.descriptor() == none:
            return
        if self.secure and self.channel.established():
            discard(self.send_close_notify() catch: recover ())
        self.channel.wipe()
        self.secure = false
        try self.connection.close()

    ## Close without close_notify, ignoring errors; for unwinding.
    pub mutating func destroy():
        self.channel.wipe()
        self.secure = false
        self.connection.destroy()

    mutating func send_close_notify() -> !:
        var link = try self.link()
        try self.channel.send_alert(&link, 1, 0)

    mutating func link() -> net.DeadlineStream!:
        return try self.link_with(self.deadline, self.cancellation)

    ## A deadline view of the socket, switching it to nonblocking on first use.
    mutating func link_with(deadline: net.Deadline, cancellation: sync.Cancellation*?) -> net.DeadlineStream!:
        if not self.prepared:
            try self.connection.set_nonblocking(true)
            self.prepared = true
        return try net.DeadlineStream.over(&self.connection, deadline, cancellation)
