## The exact public certificate path served by the existing Lucia OS Caddy VPS
## on 2026-09-19. The leaf is intentionally checked at a fixed instant inside
## its validity interval so this regression remains deterministic.
import luce_tls.chain as chain

let leaf_b64 = b""
let ye2_b64 = b""
let root_ye_b64 = b""
let x2_cross_b64 = b""

func b64_value(ch: u8) -> u8!:
    if ch >= 'A' and ch <= 'Z': return ch - 'A'
    if ch >= 'a' and ch <= 'z': return ch - 'a' + 26
    if ch >= '0' and ch <= '9': return ch - '0' + 52
    if ch == '+': return 62
    if ch == '/': return 63
    error(chain.invalid, "invalid fixture base64")

func decode(input: const u8[], output: u8[]) -> usize!:
    if input.length == 0 or input.length % 4 != 0:
        error(chain.invalid, "invalid fixture base64 length")
    var at: usize = 0
    var used: usize = 0
    while at < input.length:
        let a = try b64_value(input[at])
        let b = try b64_value(input[at + 1])
        let c = 0 if input[at + 2] == '=' else try b64_value(input[at + 2])
        let d = 0 if input[at + 3] == '=' else try b64_value(input[at + 3])
        if used >= output.length: error(chain.invalid, "fixture output is full")
        output[used] = (a << 2) | (b >> 4)
        used += 1
        if input[at + 2] != '=':
            if used >= output.length: error(chain.invalid, "fixture output is full")
            output[used] = (b << 4) | (c >> 2)
            used += 1
        if input[at + 3] != '=':
            if input[at + 2] == '=' or used >= output.length: error(chain.invalid, "invalid fixture base64 padding")
            output[used] = (c << 6) | d
            used += 1
        elif at + 4 != input.length:
            error(chain.invalid, "fixture base64 padding is not final")
        at += 4
    return used

func put_u24(out: u8[], at: usize*, value: usize):
    out[*at] = (u8)(value >> 16)
    out[*at + 1] = (u8)(value >> 8)
    out[*at + 2] = (u8)value
    *at += 3

func append_entry(message: u8[], at: usize*, der: const u8[]):
    put_u24(message, at, der.length)
    for i in 0..<der.length:
        message[*at + i] = der[i]
    *at += der.length
    message[*at] = 0
    message[*at + 1] = 0
    *at += 2

func make_message(message: u8[], leaf: const u8[], ye2: const u8[], root_ye: const u8[], x2: const u8[], include_x2: bool) -> usize:
    var at: usize = 0
    message[at] = 11
    at += 4
    message[at] = 0
    at += 1
    let list_at = at
    at += 3
    let list_start = at
    append_entry(message, &at, leaf)
    append_entry(message, &at, ye2)
    append_entry(message, &at, root_ye)
    if include_x2:
        append_entry(message, &at, x2)
    var patch = list_at
    put_u24(message, &patch, at - list_start)
    patch = 1
    put_u24(message, &patch, at - 4)
    return at

func rejected(message: const u8[], host: str, now: i64, root_x: const u8[], root_y: const u8[]) -> bool:
    var x: u8[32]
    var y: u8[32]
    var failed = false
    chain.verify_server_chain(message, host, now, root_x, root_y, x, y) catch failure:
        discard(failure)
        failed = true
        recover ()
    return failed

func find_bytes(haystack: const u8[], needle: const u8[]) -> usize!:
    if needle.length == 0 or needle.length > haystack.length:
        error(chain.invalid, "fixture pattern is absent")
    for at in 0..<(haystack.length - needle.length + 1):
        var equal = true
        for i in 0..<needle.length:
            if haystack[at + i] != needle[i]: equal = false
        if equal: return at
    error(chain.invalid, "fixture pattern is absent")

pub func main(arguments: str[]) -> i32!:
    discard(arguments)
    var leaf: u8[2048]
    var ye2: u8[2048]
    var root_ye: u8[2048]
    var x2: u8[2048]
    let leaf_n = try decode(leaf_b64, leaf)
    let ye2_n = try decode(ye2_b64, ye2)
    let root_ye_n = try decode(root_ye_b64, root_ye)
    let x2_n = try decode(x2_cross_b64, x2)
    var message: u8[8192]
    let full_n = make_message(message, leaf[..<leaf_n], ye2[..<ye2_n], root_ye[..<root_ye_n], x2[..<x2_n], true)
    var key_x: u8[32]
    var key_y: u8[32]
    let inside_window: i64 = 1789885378
    try chain.verify_server_chain(message[..<full_n], "kinogaki.com", inside_window,
        chain.isrg_root_x2_x, chain.isrg_root_x2_y, key_x, key_y)
    assert(key_x[0] == 0xbe and key_y[31] == 0xbb)
    assert(rejected(message[..<full_n], "pkg.luciaos.com", inside_window, chain.isrg_root_x2_x, chain.isrg_root_x2_y))
    assert(rejected(message[..<full_n], "kinogaki.com", 1700000000, chain.isrg_root_x2_x, chain.isrg_root_x2_y))
    assert(rejected(message[..<full_n], "kinogaki.com", 1800000000, chain.isrg_root_x2_x, chain.isrg_root_x2_y))
    var wrong: u8[48]
    for i in 0..<48: wrong[i] = chain.isrg_root_x2_x[i]
    wrong[0] ^= 1
    assert(rejected(message[..<full_n], "kinogaki.com", inside_window, wrong, chain.isrg_root_x2_y))
    # The anchor may be omitted from a TLS path; Root YE is signed directly by it.
    let short_n = make_message(message, leaf[..<leaf_n], ye2[..<ye2_n], root_ye[..<root_ye_n], x2[..<x2_n], false)
    try chain.verify_server_chain(message[..<short_n], "kinogaki.com", inside_window,
        chain.isrg_root_x2_x, chain.isrg_root_x2_y, key_x, key_y)
    # Mutating an authenticated leaf signature must fail.
    leaf[leaf_n - 1] ^= 1
    let bad_n = make_message(message, leaf[..<leaf_n], ye2[..<ye2_n], root_ye[..<root_ye_n], x2[..<x2_n], true)
    assert(rejected(message[..<bad_n], "kinogaki.com", inside_window, chain.isrg_root_x2_x, chain.isrg_root_x2_y))
    leaf[leaf_n - 1] ^= 1
    # Reordered and duplicate certificate paths are rejected before trust.
    let reordered_n = make_message(message, leaf[..<leaf_n], root_ye[..<root_ye_n], ye2[..<ye2_n], x2[..<x2_n], true)
    assert(rejected(message[..<reordered_n], "kinogaki.com", inside_window, chain.isrg_root_x2_x, chain.isrg_root_x2_y))
    let duplicate_n = make_message(message, leaf[..<leaf_n], ye2[..<ye2_n], ye2[..<ye2_n], x2[..<x2_n], true)
    assert(rejected(message[..<duplicate_n], "kinogaki.com", inside_window, chain.isrg_root_x2_x, chain.isrg_root_x2_y))
    # A critical extension that the validator does not understand must reject.
    let key_usage_marker = b"\x06\x03\x55\x1d\x0f\x01\x01\xff"
    let key_usage_at = try find_bytes(leaf[..<leaf_n], key_usage_marker)
    leaf[key_usage_at + 4] ^= 1
    let critical_n = make_message(message, leaf[..<leaf_n], ye2[..<ye2_n], root_ye[..<root_ye_n], x2[..<x2_n], true)
    assert(rejected(message[..<critical_n], "kinogaki.com", inside_window, chain.isrg_root_x2_x, chain.isrg_root_x2_y))
    leaf[key_usage_at + 4] ^= 1
    # Non-empty CertificateEntry extensions were not requested by this client.
    discard(make_message(message, leaf[..<leaf_n], ye2[..<ye2_n], root_ye[..<root_ye_n], x2[..<x2_n], true))
    message[8 + leaf_n] = 1
    assert(rejected(message[..<full_n], "kinogaki.com", inside_window, chain.isrg_root_x2_x, chain.isrg_root_x2_y))
    assert(rejected(message[..<full_n - 1], "kinogaki.com", inside_window, chain.isrg_root_x2_x, chain.isrg_root_x2_y))
    print("PASS strict P-384 public certificate-chain validation")
    return 0
