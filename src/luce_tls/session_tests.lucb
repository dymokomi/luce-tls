## Loopback TLS 1.3 client/server with a minted self-signed P-256 certificate.
import session as tls
import net
import thread
import crypto_native
import luce_tls.x509 as x509
import c
import io

var g_d: u8[32]
var g_qx: u8[32]
var g_qy: u8[32]
var g_cert: u8[2048]
var g_cert_n: usize
var g_port: @u64
var g_ready: @u64
var g_ok: @u64

func server_main(raw: void*?):
    discard(raw)
    let bind_addr = net.resolve((c.str)"localhost", 0) catch failure:
        return
    let listener = net.Listener.bind(bind_addr) catch failure:
        return
    let addr = listener.address() catch failure:
        return
    g_port.store((u64)addr.port, .release)
    g_ready.store(1, .release)
    var conn = listener.accept() catch failure:
        return
    var secrets = tls.Secrets()
    tls.accept(&conn, "localhost", g_cert[..<g_cert_n], g_d, g_qx, g_qy, &secrets) catch failure:
        return
    var buf: u8[16640]
    let n = tls.receive(&conn, &secrets, buf) catch failure:
        return
    if n != 4 or buf[0] != 'p' or buf[1] != 'i' or buf[2] != 'n' or buf[3] != 'g':
        return
    tls.send(&conn, &secrets, b"pong") catch failure:
        return
    g_ok.store(1, .release)
    # A second peer returns a deliberately truncated ServerHello. The client
    # must reject it through checked parsing rather than reading past the record.
    var malformed = listener.accept() catch failure:
        return
    let short_hello = b"\x16\x03\x03\x00\x01\x02"
    io.write_all(&malformed, short_hello) catch failure:
        return
    discard(malformed.close() catch: recover ())
    g_ok.store(2, .release)

func malformed_server_rejected(port: u16) -> bool:
    var secrets = tls.Secrets()
    var conn = tls.connect("localhost", port, g_qx, g_qy, &secrets) catch failure:
        discard(failure)
        return true
    discard(conn.close() catch: recover ())
    return false

pub func main(arguments: str[]) -> i32!:
    discard(arguments)
    try crypto_native.ecdsa_p256_keygen(g_d, g_qx, g_qy)
    g_cert_n = try x509.mint_self_signed("localhost", g_d, g_qx, g_qy, g_cert)
    g_ready.store(0, .relaxed)
    g_ok.store(0, .relaxed)
    var worker = try thread.spawn(server_main, none, name = "tls-server")
    defer worker.join() catch failure:
        discard(failure)
    var i: usize = 0
    while g_ready.load(.acquire) == 0 and i < 200:
        thread.sleep(10)
        i += 1
    assert(g_ready.load(.acquire) == 1)
    let port = (u16)g_port.load(.acquire)
    var secrets = tls.Secrets()
    var conn = try tls.connect("localhost", port, g_qx, g_qy, &secrets)
    try tls.send(&conn, &secrets, b"ping")
    var buf: u8[16640]
    let n = try tls.receive(&conn, &secrets, buf)
    assert(n == 4 and buf[0] == 'p' and buf[1] == 'o' and buf[2] == 'n' and buf[3] == 'g')
    i = 0
    while g_ok.load(.acquire) == 0 and i < 200:
        thread.sleep(10)
        i += 1
    assert(g_ok.load(.acquire) == 1)
    assert(malformed_server_rejected(port))
    i = 0
    while g_ok.load(.acquire) != 2 and i < 200:
        thread.sleep(10)
        i += 1
    assert(g_ok.load(.acquire) == 2)
    print("PASS TLS 1.3 loopback client/server")
    return 0
